{
  "name": "ipad-mreader",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "build:android": "tsc && vite build --mode android",
    "build-apk": "yarn build:android && cap sync android && cd android && ./gradlew assembleDebug",
    "install-apk": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "preview": "vite preview --host 0.0.0.0",
    "tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts capacitor.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.149"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.35.0",
    "happy-dom": "21.0.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
